# Base de données PostgreSQL Neon : variable DATABASE_URL fournie par Neon/Vercel
DATABASE_URL=

# CinetPay — clés serveur pour le compte marchand du Bénin
CINETPAY_API_KEY=
CINETPAY_API_PASSWORD=
SITE_URL=https://votre-domaine.vercel.app

# Espace organisateur : choisissez deux secrets longs et uniques
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Facultatif : livraison des billets par e-mail après paiement confirmé
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Billetterie NOVA <billetterie@votre-domaine.com>"
